[Unit]
Description=Gitea Actions Runner (act_runner via Docker Compose)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# ユーザ・プロジェクトパスは環境に合わせて編集する。
User=taito
Group=taito
WorkingDirectory=/home/taito/projects/AME-Team/AME-AI-Review-System
EnvironmentFile=/home/taito/projects/AME-Team/AME-AI-Review-System/.env
ExecStart=/home/taito/projects/AME-Team/AME-AI-Review-System/scripts/linux/act-runner-service.sh
ExecStop=/usr/bin/docker compose down
ExecStopPost=/usr/bin/docker compose down --remove-orphans
Restart=on-failure
RestartSec=10
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
