{
  "name": "landing-page",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint && eslint --max-warnings=0 \"src/**/*.{ts,tsx}\"",
