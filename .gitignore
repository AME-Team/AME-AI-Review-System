# ============================================================
#  AME-AI-Review-System .gitignore
#  ソースのみ追跡し、ビルド生成物・キャッシュ・一時ファイル・利用者固有データは除外する。
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
ENV/
.python-version

# --- ツール／キャッシュ ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.sqlfluff_cache/
.stylelintcache
.eslintcache

# --- Node（dev ツールのみ）---
node_modules/

# --- OS / 同期クライアント ---
Thumbs.db
ehthumbs.db
desktop.ini
*.tmp
.DS_Store

# --- エディタ ---
.vscode/
.idea/
*.swp
*~
actionlint

# --- ユーザー固有設定 (Git 管理対象外) ---
config.user.json
.env

# --- AI エージェント / ツール状態 (セッション・利用者固有) ---
.serena/
AGENTS.md
.claude/
.tokensave/
